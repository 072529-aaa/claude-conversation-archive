{
  "name": "claude-conversation-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:shared": "vite --host 127.0.0.1 --mode shared",
    "build": "tsc -b && vite build",
    "build:shared": "tsc -b && vite build --mode shared --outDir dist-shared && node scripts/package-shared.mjs",
    "preview:shared": "vite preview --host 127.0.0.1 --port 4174 --outDir dist-shared",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:fixtures": "node tests/create-fixtures.mjs",
    "test:browser": "node tests/browser-check.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
